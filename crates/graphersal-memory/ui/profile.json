{
  "name": "memory",
  "title": "graphersal-memory",
  "startTab": "overview",
  "can": { "theme": true },
  "files": "/memory-ui/",
  "tabs": [
    { "id": "overview", "title": "Overview", "module": "overview.js" },
    { "id": "memory", "title": "Memory", "module": "memory.js" },
    { "id": "graph", "title": "Graph", "module": "graph.js" },
    { "id": "always", "title": "Always loaded", "module": "always.js" },
    { "id": "conflicts", "title": "Conflicts", "module": "conflicts.js" },
    { "id": "sessions", "title": "Sessions", "module": "sessions.js" }
  ],
  "cards": {
    "memory": {
      "title": ["title", "slug"],
      "subtitle": ["kind", "where", "source_text", { "field": "updated_at", "format": "date" }],
      "badges": [
        { "field": "pinned", "text": "pinned", "tone": "accent" },
        { "field": "always", "text": "always loaded", "tone": "ok" },
        { "field": "superseded_by", "prefix": "replaced by ", "tone": "warn" },
        { "field": "has_conflict", "text": "conflict", "tone": "danger" },
        { "field": "unchecked", "text": "to check", "tone": "warn" },
        { "field": "imported", "text": "read-only" }
      ],
      "body": "body",
      "excerpt": 140,
      "fields": [
        { "field": "slug", "title": "Name" },
        { "field": "summary", "title": "Summary" },
        { "field": "hook", "title": "Start line" },
        { "field": "links", "title": "Links" },
        { "field": "linked_from", "title": "Linked from" },
        { "field": "about", "title": "About" },
        { "field": "chain_text", "title": "Decision history" },
        { "field": "conflict_text", "title": "Open conflict with" },
        { "field": "note", "title": "Note" },
        { "field": "file", "title": "File" },
        { "field": "imported_at", "title": "Imported", "format": "datetime" }
      ],
      "actions": [
        { "id": "edit", "text": "Edit", "unless": "imported" },
        { "id": "pin", "text": "Pin", "unless": "pinned", "title": "Load it at the start of every session" },
        { "id": "unpin", "text": "Unpin", "when": "pinned" },
        { "id": "forget", "text": "Forget", "kind": "danger", "unless": "imported" }
      ]
    },
    "session": {
      "title": ["headline", "title", "id"],
      "subtitle": [{ "field": "started_at", "format": "datetime" }, "harness", { "field": "turns", "prefix": "turns " }, "project_name"],
      "badges": [
        { "field": "decisions", "prefix": "decisions ", "tone": "accent" },
        { "field": "corrections", "prefix": "corrections ", "tone": "warn" },
        { "field": "open_threads", "prefix": "open threads ", "tone": "danger" }
      ],
      "fields": []
    },
    "fact": {
      "title": "fact",
      "badges": [
        { "field": "kind", "tone": { "decision": "accent", "correction": "warn", "outcome": "ok", "open_thread": "danger" } }
      ],
      "subtitle": [{ "field": "at", "format": "date" }, "headline", "project_name"],
      "body": "why",
      "fields": []
    },
    "supersedes": {
      "title": "title",
      "subtitle": [{ "field": "at", "format": "datetime" }, "where"],
      "fields": []
    },
    "conflicts_with": {
      "title": "title",
      "subtitle": [{ "field": "at", "format": "datetime" }, "where"],
      "fields": []
    },
    "narrows": {
      "title": "title",
      "subtitle": [{ "field": "at", "format": "datetime" }, "where"],
      "fields": []
    },
    "relates_to": {
      "title": "title",
      "subtitle": [{ "field": "at", "format": "datetime" }, "where"],
      "fields": []
    },
    "about": {
      "title": "title",
      "subtitle": [{ "field": "at", "format": "datetime" }, "where"],
      "fields": []
    },
    "contains": {
      "title": "title",
      "subtitle": [{ "field": "at", "format": "datetime" }, "where"],
      "fields": []
    }
  },
  "graph": {
    "nodes": {
      "memory": { "color": "--text-faint", "size": 26 },
      "session": { "shape": "round-rectangle", "color": "--text-faint", "size": 22 },
      "fact": { "shape": "diamond", "color": "--text-faint", "size": 18 }
    },
    "edges": {
      "supersedes": { "color": "--text-muted", "width": 2, "arrow": true },
      "conflicts_with": { "color": "--danger", "width": 2.4, "arrow": false },
      "narrows": { "color": "--accent", "style": "dotted", "width": 1.8, "arrow": true },
      "relates_to": { "color": "--text-faint", "width": 0.8, "arrow": false },
      "about": { "color": "--text-faint", "style": "dashed", "width": 1, "arrow": true },
      "contains": { "color": "--text-faint", "width": 1, "arrow": true },
      "edited": { "color": "--text-faint", "style": "dotted", "width": 1, "arrow": true }
    },
    "classes": {
      "kind-user": { "color": "--ai-accent" },
      "kind-feedback": { "color": "--accent" },
      "kind-project": { "color": "--ok" },
      "kind-reference": { "color": "--warn" },
      "imported": { "border": { "width": 2.5, "style": "dashed", "color": "--text" } },
      "always": { "border": { "width": 4.5, "color": "--text" } },
      "superseded": { "opacity": 0.3 },
      "fact-decision": { "color": "--accent" },
      "fact-correction": { "color": "--warn" },
      "fact-outcome": { "color": "--ok" },
      "fact-open-thread": { "color": "--danger" }
    },
    "legendLabels": "edges",
    "legend": [
      { "text": "how to work (feedback)", "node": { "color": "--accent" } },
      { "text": "about you (user)", "node": { "color": "--ai-accent" } },
      { "text": "project fact or decision", "node": { "color": "--ok" } },
      { "text": "where things are (reference)", "node": { "color": "--warn" } },
      { "text": "loaded at every session start", "node": { "border": { "width": 4.5, "color": "--text" } } },
      { "text": "imported from a file (read-only)", "node": { "border": { "width": 2.5, "style": "dashed", "color": "--text" } } },
      { "text": "replaced", "node": { "opacity": 0.3 } },
      { "text": "session", "node": { "shape": "round-rectangle" } },
      { "text": "fact", "node": { "shape": "diamond" } }
    ]
  }
}
